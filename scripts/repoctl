#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# An explicit interpreter choice wins, including an invalid one (fail closed).
# Otherwise use the environment installed alongside this runtime, never the
# current product workspace's .venv or its VIRTUAL_ENV.
if [[ ${PYTHON+x} ]]; then
  PYTHON_BIN="$PYTHON"
elif [[ -d "$ROOT/.venv" ]]; then
  if [[ ! -f "$ROOT/.venv/pyvenv.cfg" ]]; then
    echo "repoctl runtime .venv has no pyvenv.cfg" >&2
    exit 127
  fi
  PYTHON_BIN="$ROOT/.venv/bin/python"
else
  PYTHON_BIN="python3"
fi
if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "repoctl Python interpreter is unavailable: $PYTHON_BIN" >&2
  exit 127
fi
export PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON_BIN" -P -B -m tools.repoctl "$@"
